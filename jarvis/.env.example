# Required. ChatGPT Plus and OpenAI API billing are separate.
# Leave blank here when OPENAI_API_KEY is already set in Windows.
OPENAI_API_KEY=

STT_MODEL=gpt-4o-mini-transcribe
TEXT_MODEL=gpt-5.6-luna
FOLLOWUP_MODEL=gpt-5.4-nano
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=cedar
TTS_ENABLED=true

# cloud uses OpenAI speech. local uses Kokoro for English and Piper Lisa
# for Swedish. You can switch by saying "use local TTS" or "use OpenAI TTS".
TTS_BACKEND=cloud
LOCAL_TTS_SWEDISH_VOICE=sv_SE-lisa-medium
LOCAL_TTS_KOKORO_VOICE=bm_george
LOCAL_TTS_KOKORO_LANGUAGE=en-gb
LOCAL_TTS_KOKORO_SPEED=1.03
LOCAL_TTS_LENGTH_SCALE=0.96
LOCAL_TTS_VOLUME=1.0
FOLLOWUP_MIN_CAPTURE_RMS=250

# Leave blank for Windows defaults. Run list_devices.bat for numeric IDs.
MIC_DEVICE=
SPEAKER_DEVICE=

# Wake detection requires several stable openWakeWord score changes. The model
# score can peak after the spoken phrase has ended, so recent microphone energy
# is retained for a short window instead of checking only the current 30 ms frame.
WAKE_THRESHOLD=0.45
WAKE_VAD_THRESHOLD=0.20
WAKE_COOLDOWN_SECONDS=1.5
WAKE_CONFIRM_THRESHOLD=0.44
WAKE_CONFIRM_HITS=2
WAKE_CONFIRM_WINDOW_FRAMES=12
WAKE_ENERGY_WINDOW_FRAMES=50
WAKE_RECENT_RMS_THRESHOLD=25
WAKE_CLIPPED_MIN_PEAK=0.90
WAKE_CLIPPED_MIN_HITS=2

VAD_AGGRESSIVENESS=3
ENERGY_THRESHOLD=350
VAD_WINDOW_FRAMES=10
VAD_MIN_VOICED_FRAMES=4
FOLLOWUP_START_WINDOW_FRAMES=8
FOLLOWUP_START_MIN_VOICED_FRAMES=3
END_SILENCE_SECONDS=0.75
FOLLOWUP_END_SILENCE_SECONDS=0.75
FOLLOWUP_TIMEOUT_SECONDS=4.0
FOLLOWUP_REQUIRE_INTENT=true
MAX_UTTERANCE_SECONDS=12
HARD_MAX_UTTERANCE_SECONDS=12
PRE_ROLL_SECONDS=1.5

# Very quiet wake-only captures skip the paid STT request and use the already
# confirmed wake phrase. Increase these only if quiet commands are skipped.
STT_WAKE_ONLY_MAX_RMS=120
STT_WAKE_ONLY_MAX_VAD_RATIO=0.08

# Per-run and per-wake-conversation logs. Transcripts are stored locally and
# obvious API keys, tokens, passwords, secrets, and email addresses are redacted.
SESSION_LOGGING_ENABLED=true
SESSION_LOG_INCLUDE_TRANSCRIPTS=true
SESSION_LOG_RETENTION_DAYS=30
SESSION_LOG_MAX_SESSIONS=100

TIMEZONE=Europe/Stockholm
MAX_HISTORY_MESSAGES=8
DEBUG=true

# Updates are checked immediately at startup and then every hour. New automatic
# updates are staged first and Jarvis asks for spoken permission before installing.
AUTO_UPDATE_ENABLED=true
UPDATE_CHECK_INTERVAL_SECONDS=3600
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/Kootryne/AutoUpdaterTest/main/jarvis/manifest.json
UPDATE_SOURCE_ZIP_URL=https://github.com/Kootryne/AutoUpdaterTest/archive/refs/heads/main.zip

# GPT-5.6 Sol is the high-reasoning architect. GPT-5.6 Luna is the fast,
# cost-efficient implementation and runtime model.
SKILL_PLANNER_ALIAS=Sol
SKILL_PLANNER_MODEL=gpt-5.6-sol
SKILL_PLANNER_REASONING=high
SKILL_BUILDER_ALIAS=Luna
SKILL_BUILDER_MODEL=gpt-5.6-luna
SKILL_BUILDER_REASONING=low
SKILL_RUNTIME_MODEL=gpt-5.6-luna
SKILL_RUNTIME_REASONING=low
SKILL_BUILD_RETRIES=2
SKILL_MAX_TESTS=2
SKILL_LIVE_TESTS=true
BACKGROUND_TASK_WORKERS=3

# Shared skills and automatic developer suggestions. Create a fine-grained GitHub
# token with Contents: read/write and Issues: read/write for this repository.
# The token remains local and is never committed to GitHub.
GITHUB_TOKEN=
JARVIS_GITHUB_REPOSITORY=Kootryne/AutoUpdaterTest
JARVIS_GITHUB_BRANCH=main
SHARED_SKILLS_SYNC_SECONDS=3600

# Optional Home Assistant configuration.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
